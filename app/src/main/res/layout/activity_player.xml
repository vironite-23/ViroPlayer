<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/player_black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/player_black" />

    <FrameLayout
        android:id="@+id/controls_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false">

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="#66000000">

            <ImageButton android:id="@+id/back_button" style="@style/PlayerIconButton" android:contentDescription="Back" android:src="@drawable/ic_back" />
            <ImageButton android:id="@+id/queue_button" style="@style/PlayerIconButton" android:contentDescription="Playback queue" android:src="@drawable/ic_queue" />
            <TextView
                android:id="@+id/title_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/player_text_dim"
                android:textSize="18sp" />
            <ImageButton android:id="@+id/cast_button" style="@style/PlayerIconButton" android:contentDescription="Cast" android:src="@drawable/ic_cast" />
            <ImageButton android:id="@+id/screenshot_button" style="@style/PlayerIconButton" android:contentDescription="Screenshot" android:src="@drawable/ic_camera" />
            <ImageButton android:id="@+id/mute_button" style="@style/PlayerIconButton" android:contentDescription="Mute" android:src="@drawable/ic_volume_off" />
            <ImageButton android:id="@+id/lock_button" style="@style/PlayerIconButton" android:contentDescription="Lock controls" android:src="@drawable/ic_lock" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quick_bar"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="88dp"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageButton android:id="@+id/repeat_button" style="@style/PlayerQuickButton" android:contentDescription="Repeat" android:src="@drawable/ic_repeat" />
            <ImageButton android:id="@+id/audio_button" style="@style/PlayerQuickButton" android:contentDescription="Audio track" android:src="@drawable/ic_music_note" />
            <ImageButton android:id="@+id/subtitle_button" style="@style/PlayerQuickButton" android:contentDescription="Subtitles" android:src="@drawable/ic_cc" />
            <ImageButton android:id="@+id/aspect_button" style="@style/PlayerQuickButton" android:contentDescription="Aspect ratio" android:src="@drawable/ic_aspect" />
            <ImageButton android:id="@+id/speed_button" style="@style/PlayerQuickButton" android:contentDescription="Playback speed" android:src="@drawable/ic_speed" />
            <ImageButton android:id="@+id/player_menu_button" style="@style/PlayerQuickButton" android:contentDescription="More player options" android:src="@drawable/ic_player_settings" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/progress_area"
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingBottom="4dp">
            <SeekBar
                android:id="@+id/progress_bar"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:max="1000"
                android:progress="0"
                android:progressTint="@color/player_scrubber"
                android:thumbTint="@android:color/white" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/position_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="00:00" android:textColor="@color/player_text_dim" android:textSize="16sp" />
                <TextView android:id="@+id/duration_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00" android:textColor="@color/player_text_dim" android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/transport_bar"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_control"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageButton android:id="@+id/transport_lock" style="@style/PlayerTransportButton" android:contentDescription="Lock" android:src="@drawable/ic_lock" />
            <ImageButton android:id="@+id/rewind_button" style="@style/PlayerTransportButton" android:contentDescription="Previous / rewind" android:src="@drawable/ic_rewind" />
            <ImageButton android:id="@+id/play_button" style="@style/PlayerTransportButton" android:contentDescription="Play or pause" android:src="@drawable/ic_play" />
            <ImageButton android:id="@+id/forward_button" style="@style/PlayerTransportButton" android:contentDescription="Next / forward" android:src="@drawable/ic_forward" />
            <ImageButton android:id="@+id/fullscreen_button" style="@style/PlayerTransportButton" android:contentDescription="Fullscreen" android:src="@drawable/ic_fullscreen" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
