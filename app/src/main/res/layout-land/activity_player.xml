<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/player_black">
    <androidx.media3.ui.PlayerView android:id="@+id/player_view" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/player_black" />
    <FrameLayout android:id="@+id/controls_overlay" android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:id="@+id/top_bar" android:layout_width="match_parent" android:layout_height="64dp" android:layout_gravity="top" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="62dp" android:paddingEnd="18dp" android:background="#44000000">
            <ImageButton android:id="@+id/back_button" style="@style/PlayerIconButton" android:contentDescription="Back" android:src="@drawable/ic_back" />
            <ImageButton android:id="@+id/queue_button" style="@style/PlayerIconButton" android:contentDescription="Playback queue" android:src="@drawable/ic_queue" />
            <TextView android:id="@+id/title_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:textColor="@color/player_text_dim" android:textSize="18sp" />
            <ImageButton android:id="@+id/cast_button" style="@style/PlayerIconButton" android:contentDescription="Cast" android:src="@drawable/ic_cast" />
            <ImageButton android:id="@+id/screenshot_button" style="@style/PlayerIconButton" android:contentDescription="Screenshot" android:src="@drawable/ic_camera" />
            <ImageButton android:id="@+id/mute_button" style="@style/PlayerIconButton" android:contentDescription="Mute" android:src="@drawable/ic_volume_off" />
            <ImageButton android:id="@+id/lock_button" style="@style/PlayerIconButton" android:contentDescription="Lock controls" android:src="@drawable/ic_lock" />
        </LinearLayout>
        <LinearLayout android:id="@+id/quick_bar" android:layout_width="wrap_content" android:layout_height="52dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="34dp" android:gravity="center" android:orientation="horizontal">
            <ImageButton android:id="@+id/repeat_button" style="@style/PlayerQuickButton" android:src="@drawable/ic_repeat" android:contentDescription="Repeat" />
            <ImageButton android:id="@+id/audio_button" style="@style/PlayerQuickButton" android:src="@drawable/ic_music_note" android:contentDescription="Audio track" />
            <ImageButton android:id="@+id/subtitle_button" style="@style/PlayerQuickButton" android:src="@drawable/ic_cc" android:contentDescription="Subtitles" />
            <ImageButton android:id="@+id/aspect_button" style="@style/PlayerQuickButton" android:src="@drawable/ic_aspect" android:contentDescription="Aspect ratio" />
            <ImageButton android:id="@+id/speed_button" style="@style/PlayerQuickButton" android:src="@drawable/ic_speed" android:contentDescription="Playback speed" />
            <ImageButton android:id="@+id/player_menu_button" style="@style/PlayerQuickButton" android:src="@drawable/ic_player_settings" android:contentDescription="More player options" />
        </LinearLayout>
        <LinearLayout android:id="@+id/progress_area" android:layout_width="match_parent" android:layout_height="108dp" android:layout_gravity="bottom" android:orientation="vertical" android:paddingStart="72dp" android:paddingEnd="72dp" android:paddingBottom="2dp">
            <SeekBar android:id="@+id/progress_bar" android:layout_width="match_parent" android:layout_height="30dp" android:max="1000" android:progressTint="@color/player_scrubber" android:thumbTint="@android:color/white" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"><TextView android:id="@+id/position_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="00:00" android:textColor="@color/player_text_dim" android:textSize="16sp" /><TextView android:id="@+id/duration_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00" android:textColor="@color/player_text_dim" android:textSize="16sp" /></LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/transport_bar" android:layout_width="wrap_content" android:layout_height="64dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="12dp" android:background="@drawable/bg_control" android:gravity="center" android:orientation="horizontal">
            <ImageButton android:id="@+id/transport_lock" style="@style/PlayerTransportButton" android:src="@drawable/ic_lock" android:contentDescription="Lock" />
            <ImageButton android:id="@+id/rewind_button" style="@style/PlayerTransportButton" android:src="@drawable/ic_rewind" android:contentDescription="Rewind" />
            <ImageButton android:id="@+id/play_button" style="@style/PlayerTransportButton" android:src="@drawable/ic_play" android:contentDescription="Play or pause" />
            <ImageButton android:id="@+id/forward_button" style="@style/PlayerTransportButton" android:src="@drawable/ic_forward" android:contentDescription="Forward" />
            <ImageButton android:id="@+id/fullscreen_button" style="@style/PlayerTransportButton" android:src="@drawable/ic_fullscreen" android:contentDescription="Fullscreen" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
